{
  "name": "devcon8-workshop",
  "version": "1.0.0",
  "private": true,
  "description": "Devcon8 Workshop for X402",
  "main": "index.js",
  "scripts": {
    "format": "pnpm exec biome format --write .",
    "check": "pnpm exec biome check --write .",
    "x402client": "pnpm --filter x402client",
    "x402server": "pnpm --filter x402server",
    "facilitator": "pnpm --filter facilitator",
    "x402mcp": "pnpm --filter x402mcp",
    "setup": "sh ./scripts/setup.sh",
    "start": "sh ./scripts/start.sh",
    "stop": "sh ./scripts/stop.sh",
    "cf:dev:facilitator": "pnpm --filter facilitator run cf:dev",
    "cf:dev:server": "pnpm --filter x402server run cf:dev",
    "cf:dev:mcp": "pnpm --filter x402mcp run cf:dev",
    "deploy:facilitator": "pnpm --filter facilitator run cf:deploy",
    "deploy:server": "pnpm --filter x402server run cf:deploy",
    "deploy:mcp": "pnpm --filter x402mcp run cf:deploy"
  },
  "keywords": ["blockchain", "web3", "x402", "devcon8", "workshop", "arc", "facilitator", "mcp", "server", "client", "AI", "payment"],
  "author": "mashharuki",
  "license": "ISC",
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@biomejs/biome": "2.5.10"
  }
}
