{
  "name": "x402mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server that lets Claude Code run the x402 demo with a Privy user-owned wallet",
  "scripts": {
    "build": "tsc -p tsconfig.worker.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "cf:typecheck": "wrangler types && tsc -p tsconfig.worker.json",
    "cf:dev": "node ../../scripts/wrangler.mjs dev --port 8790",
    "cf:deploy": "node ../../scripts/wrangler.mjs deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@privy-io/js-sdk-core": "^0.76.1",
    "@privy-io/node": "^0.34.0",
    "@x402-sample/config": "workspace:*",
    "@x402/core": "^2.23.0",
    "@x402/evm": "^2.23.0",
    "@x402/fetch": "^2.23.0",
    "agents": "^0.24.0",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.12",
    "viem": "^2.55.19",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.136.1"
  }
}
