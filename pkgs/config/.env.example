# server / facilitator / client / mcp で共有する設定。
# `pnpm setup` が、このファイルを pkgs/config/.env にコピーする。
# チェーンやトークン、価格を変えるときは、コピー後の .env だけを編集する。
# (秘密鍵や、パッケージごとのURL・アドレスは、各パッケージの .env に書く)

# チェーン: viem/chains のエクスポート名(例: arcTestnet, baseSepolia)
CHAIN_NAME=arcTestnet

# 支払いの受取先アドレス(必須)。
# serverの受取先(payTo)と、mcpのPrivyポリシーが許可する送金先の両方に使う
PAYEE_ADDRESS=

# 決済トークン。TOKEN_NAME / TOKEN_VERSION はトークンのEIP-712ドメインで、
# オンチェーンの name() / version() と一致させる(違うと verify が revert する)
ASSET_ADDRESS=0x3600000000000000000000000000000000000000
TOKEN_NAME=USDC
TOKEN_VERSION=2
TOKEN_DECIMALS=6

# 価格(トークンの単位。0.5 = 0.5 USDC)
# /weather の固定料金(exact)
PRICE_WEATHER=0.5
# /usage の1ユニットあたりの料金と、署名で認可する最大額(upto)
USAGE_UNIT_PRICE=0.1
USAGE_MAX_AMOUNT=0.5

# 1回の支払いで署名を許可する上限(atomic units。USDCは 1000000 = 1 USDC)
# client の署名前チェックと、mcp の Privy ポリシーの両方に使う
MAX_AMOUNT_PER_PAYMENT=1000000
