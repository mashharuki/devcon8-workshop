# Configuration shared by the server, facilitator, client, and MCP.
# `pnpm setup` copies this file to pkgs/config/.env.
# To change the chain, token, or pricing, edit only the copied .env file.
# (Put private keys and package-specific URLs or addresses in each package's .env file.)

# Chain: export name from viem/chains (for example, arcTestnet or baseSepolia)
CHAIN_NAME=arcTestnet

# Required payment recipient address.
# Used both as the server's recipient (payTo) and the destination allowed by the MCP Privy policy
PAYEE_ADDRESS=

# Payment token. TOKEN_NAME / TOKEN_VERSION define the token's EIP-712 domain and
# must match the on-chain name() / version() (otherwise verify reverts)
ASSET_ADDRESS=0x3600000000000000000000000000000000000000
TOKEN_NAME=USDC
TOKEN_VERSION=2
TOKEN_DECIMALS=6

# Prices in token units (0.5 = 0.5 USDC)
# Fixed price for /weather (exact)
PRICE_WEATHER=0.5
# Per-unit price for /usage and maximum amount authorized by the signature (upto)
USAGE_UNIT_PRICE=0.1
USAGE_MAX_AMOUNT=0.5

# Per-payment signing limit (atomic units; for USDC, 1000000 = 1 USDC)
# Used by both the client's pre-signing check and the MCP Privy policy
MAX_AMOUNT_PER_PAYMENT=1000000
